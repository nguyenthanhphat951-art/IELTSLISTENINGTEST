<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IELTS Listening Practice Test (Test 2)</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Merriweather', 'serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Tùy chỉnh thanh cuộn cho mượt mà */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f4f4f5; }
        ::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }

        /* Tùy chỉnh vùng bôi màu câu hỏi */
        mark.ielts-highlight { border-radius: 2px; cursor: pointer; transition: opacity 0.2s; }
        mark.ielts-highlight:hover { opacity: 0.8; }
        
        .question-target { transition: background-color 0.5s ease; scroll-margin-top: 30px; }
        .question-target.highlight-scroll { background-color: #f4f4f5; }

        /* Ô nhập liệu dạng gạch chân đặc trưng của IELTS */
        .blank-underlined {
            border-bottom: 2px solid #000;
            background: transparent;
            outline: none;
            transition: all 0.2s ease;
        }
        .blank-underlined:focus {
            border-bottom-color: #2563eb;
            background-color: #eff6ff;
        }

        /* Định dạng các nút chọn trắc nghiệm và checkbox */
        .mc-opt-btn.active { border-color: #000000 !important; background-color: #f4f4f5 !important; }
        .mc-opt-btn.active .radio-circle { border-color: #000000 !important; }
        .mc-opt-btn.active .radio-dot { transform: scale(1) !important; opacity: 1 !important; }

        /* Custom dropdown style */
        .custom-select {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='6 9 12 15 18 9'%3E%3C/polyline%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: right 8px center;
            background-size: 14px;
            padding-right: 28px;
        }

        /* Định dạng hiển thị màu sắc khi đã chấm điểm */
        .graded-correct { background-color: #f0fdf4 !important; border-color: #22c55e !important; color: #15803d !important; }
        .graded-correct .radio-circle { border-color: #22c55e !important; }
        .graded-correct .radio-dot { background-color: #22c55e !important; transform: scale(1) !important; opacity: 1 !important; }

        .graded-wrong { background-color: #fef2f2 !important; border-color: #ef4444 !important; color: #b91c1c !important; }
        .graded-wrong .radio-circle { border-color: #ef4444 !important; }
        .graded-wrong .radio-dot { background-color: #ef4444 !important; transform: scale(1) !important; opacity: 1 !important; }
        .text-line-through { text-decoration: line-through; }

        .input-correct { border-color: #22c55e !important; background-color: #f0fdf4 !important; color: #15803d !important; font-weight: bold; }
        .input-wrong { border-color: #ef4444 !important; background-color: #fef2f2 !important; color: #ef4444 !important; text-decoration: line-through; }
        
        .nav-correct { background-color: #22c55e !important; color: white !important; border-color: #16a34a !important; }
        .nav-wrong { background-color: #ef4444 !important; color: white !important; border-color: #dc2626 !important; }
    </style>
</head>
<body class="bg-white text-zinc-900 overflow-hidden h-screen flex flex-col font-sans select-none">

    <!-- Đối tượng Audio trung tâm để phát âm thanh cục bộ -->
    <audio id="exam-audio" preload="auto"></audio>

    <!-- HỘP THOẠI BẮT ĐẦU THI (Nơi kéo thả file từ máy tính) -->
    <div id="start-modal" class="fixed inset-0 bg-zinc-950 backdrop-blur-md flex items-center justify-center z-[200] transition-opacity duration-300">
        <div class="bg-white p-8 rounded-xl border border-zinc-200 w-11/12 max-w-lg shadow-2xl text-center">
            <div class="w-16 h-16 rounded-full bg-black text-white flex items-center justify-center mx-auto mb-5 shadow-lg">
                <i class="fa-solid fa-headphones-simple text-2xl animate-pulse"></i>
            </div>
            <h2 class="text-xl font-extrabold uppercase tracking-wider mb-2 text-black">IELTS Listening Practice Test 2</h2>
            <p class="text-xs text-zinc-500 mb-6 leading-relaxed font-medium">
                To start the continuous listening simulation, please drag and drop the single continuous MP3 test audio file from your computer below, or click to browse. Once loaded, the timer starts and the audio plays without control options to replicate the real exam.
            </p>
            
            <!-- VÙNG KÉO THẢ / CHỌN FILE ÂM THANH TRỰC TIẾP -->
            <div id="audio-drop-zone" class="border-2 border-dashed border-zinc-300 hover:border-black rounded-lg p-8 mb-6 cursor-pointer transition-all bg-zinc-50 flex flex-col items-center justify-center gap-2">
                <i class="fa-solid fa-file-audio text-4xl text-zinc-400" id="audio-drop-icon"></i>
                <p class="text-xs font-bold text-zinc-700" id="audio-drop-text">Drag & drop your full test audio here, or click to browse</p>
                <p class="text-[10px] text-zinc-400">Accepts a single continuous .mp3 or .wav file</p>
                <input type="file" id="local-audio-input" accept="audio/*" class="hidden">
            </div>

            <button class="bg-zinc-300 text-zinc-500 font-bold py-4 px-10 text-xs uppercase tracking-widest rounded-lg transition-all w-full cursor-not-allowed" id="btn-start-test" disabled>
                Select Audio File First
            </button>
        </div>
    </div>

    <!-- HEADER CHỨA THỜI GIAN VÀ TRẠNG THÁI KHÔNG CÓ NÚT PLAY -->
    <header class="bg-black text-white px-6 py-4 flex justify-between items-center border-b-2 border-black z-30 select-none shrink-0">
        <div class="logo-area flex items-center gap-4">
            <h1 class="text-lg font-bold tracking-widest uppercase">IELTS Listening</h1>
            <span class="bg-zinc-800 text-zinc-300 text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded">Continuous CD Mode</span>
        </div>

        <!-- Không có nút Play/Pause và thanh tua để đúng chuẩn CD thi thật - chỉ hiển thị trạng thái phát và Volume -->
        <div class="hidden sm:flex items-center gap-4 bg-zinc-950 px-4 py-2 rounded-lg border border-zinc-800 text-xs select-none">
            <span id="audio-status-label" class="text-zinc-400 font-semibold tracking-wide flex items-center gap-2">
                <i class="fa-solid fa-circle text-[8px] text-zinc-600"></i> No audio loaded
            </span>
            <div class="h-4 w-[1px] bg-zinc-800"></div>
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-volume-high text-zinc-400 text-[10px]"></i>
                <input type="range" id="volume-control" min="0" max="1" step="0.05" value="1" class="w-20 accent-white h-1 bg-zinc-700 rounded-lg cursor-pointer" title="Adjust Volume">
            </div>
        </div>
        
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-3 bg-zinc-900 px-4 py-2 rounded border border-zinc-800 font-mono text-base font-bold transition-all" id="countdown-timer">
                <i class="fa-regular fa-clock text-sm"></i>
                <span id="timer-display">40:00</span>
            </div>
            <button class="bg-white hover:bg-zinc-200 text-black font-bold py-2 px-4 rounded text-xs uppercase tracking-wider transition-colors" id="btn-submit-exam">
                Submit Test
            </button>
        </div>
    </header>

    <!-- CÁC TAB CHUYỂN PHẦN CÂU HỎI -->
    <div class="flex bg-zinc-100 border-b border-zinc-200 px-6 gap-1 select-none z-20 shrink-0">
        <button class="tab-btn active px-6 py-3 text-xs font-bold text-zinc-500 border-b-2 border-transparent uppercase tracking-wider hover:text-black hover:bg-zinc-200 transition-all" data-target="1">Part 1</button>
        <button class="tab-btn px-6 py-3 text-xs font-bold text-zinc-500 border-b-2 border-transparent uppercase tracking-wider hover:text-black hover:bg-zinc-200 transition-all" data-target="2">Part 2</button>
        <button class="tab-btn px-6 py-3 text-xs font-bold text-zinc-500 border-b-2 border-transparent uppercase tracking-wider hover:text-black hover:bg-zinc-200 transition-all" data-target="3">Part 3</button>
        <button class="tab-btn px-6 py-3 text-xs font-bold text-zinc-500 border-b-2 border-transparent uppercase tracking-wider hover:text-black hover:bg-zinc-200 transition-all" data-target="4">Part 4</button>
    </div>

    <!-- KHÔNG GIAN LÀM BÀI -->
    <div class="flex flex-1 overflow-hidden relative" id="workspace-container">
        
        <!-- BẢNG BÊN TRÁI: HIỂN THỊ CÁC CÂU HỎI -->
        <div class="w-[80%] h-full overflow-y-auto p-10 bg-white border-r border-zinc-200 relative select-text" id="questions-workspace">
            
            <!-- Hướng dẫn tô màu -->
            <div class="bg-zinc-100 border border-zinc-200 p-3 rounded text-xs text-zinc-700 mb-6 flex items-center gap-2 select-none">
                <i class="fa-solid fa-circle-info text-black flex-shrink-0"></i>
                <span><strong>Highlight Tool:</strong> Select any text in the questions area with your mouse to highlight it. Click on the highlighted text to remove it.</span>
            </div>

            <!-- PART 1 QUESTIONS -->
            <div id="part-content-1" class="part-content block">
                <div class="text-xs uppercase font-bold text-zinc-500 mb-2 tracking-wider">Listening Part 1</div>
                <h1 class="font-serif text-3xl font-bold mb-5 pb-3 border-b-2 border-black">Questions 1–10</h1>
                
                <div class="bg-zinc-50 border-l-4 border-black p-4 mb-8 select-none">
                    <p class="text-sm font-semibold">Complete the table below.</p>
                    <p class="text-xs text-zinc-600 mt-1">Write <span class="font-bold text-black">ONE WORD AND/OR A NUMBER</span> for each answer.</p>
                </div>

                <div class="border border-zinc-200 rounded-lg p-8 bg-zinc-50/50 mb-8 font-serif leading-relaxed text-black max-w-3xl mx-auto">
                    <div class="text-xl font-bold mb-6 text-center text-zinc-800 border-b border-zinc-200 pb-3">Support for Caregivers</div>

                    <div class="space-y-6">
                        <div>
                            <p class="font-bold text-zinc-800 mb-2">Local councils can arrange practical support to help those caring for elderly people at home.</p>
                            <p class="font-bold text-zinc-700 mb-2">This can give the carer:</p>
                            <ul class="list-disc pl-6 space-y-2">
                                <li>time for other responsibilities</li>
                                <li class="question-target p-1 rounded" id="q-target-1">
                                    a <strong>1</strong> <input type="text" id="blank-q1" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="1">
                                </li>
                            </ul>
                        </div>

                        <div>
                            <div class="text-lg font-bold text-zinc-900 mb-3 border-b border-zinc-200 pb-1">Assessment of mother’s needs</div>
                            <p class="font-semibold text-zinc-700 mb-2">This may include discussion of:</p>
                            <ul class="list-disc pl-6 space-y-3">
                                <li class="question-target p-1 rounded" id="q-target-2">
                                    how much <strong>2</strong> <input type="text" id="blank-q2" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="2"> the caring involves
                                </li>
                                <li>what types of tasks are involved, e.g.
                                    <ul class="list-circle pl-6 mt-2 space-y-2">
                                        <li>help with dressing</li>
                                        <li class="question-target p-1 rounded" id="q-target-3">
                                            helping her have a <strong>3</strong> <input type="text" id="blank-q3" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="3">
                                        </li>
                                        <li>shopping</li>
                                        <li>helping with meals</li>
                                        <li class="question-target p-1 rounded" id="q-target-4">
                                            dealing with <strong>4</strong> <input type="text" id="blank-q4" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="4">
                                        </li>
                                    </ul>
                                </li>
                                <li>any aspects of caring that are especially difficult, e.g.
                                    <ul class="list-circle pl-6 mt-2 space-y-2">
                                        <li class="question-target p-1 rounded" id="q-target-5">
                                            loss of <strong>5</strong> <input type="text" id="blank-q5" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="5">
                                        </li>
                                        <li class="question-target p-1 rounded" id="q-target-6">
                                            <strong>6</strong> <input type="text" id="blank-q6" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="6"> her
                                        </li>
                                        <li class="question-target p-1 rounded" id="q-target-7">
                                            preventing a <strong>7</strong> <input type="text" id="blank-q7" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="7">
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </div>

                        <div>
                            <div class="text-lg font-bold text-zinc-900 mb-3 border-b border-zinc-200 pb-1">Types of support that may be offered to carers</div>
                            <ul class="list-disc pl-6 space-y-3">
                                <li class="question-target p-1 rounded" id="q-target-8">
                                    transport costs, e.g. cost of a <strong>8</strong> <input type="text" id="blank-q8" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="8">
                                </li>
                                <li class="question-target p-1 rounded" id="q-target-9">
                                    car-related costs, e.g. fuel and <strong>9</strong> <input type="text" id="blank-q9" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="9">
                                </li>
                                <li>help with housework</li>
                                <li class="question-target p-1 rounded" id="q-target-10">
                                    help to reduce <strong>10</strong> <input type="text" id="blank-q10" class="blank-underlined font-mono font-bold text-center px-1 w-40 text-blue-600" data-qnum="10">
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PART 2 QUESTIONS -->
            <div id="part-content-2" class="part-content hidden">
                <div class="text-xs uppercase font-bold text-zinc-500 mb-2 tracking-wider">Listening Part 2</div>
                <h1 class="font-serif text-3xl font-bold mb-5 pb-3 border-b-2 border-black">Questions 11–20</h1>
                
                <!-- Q11-16 Block -->
                <div class="bg-zinc-50 border-l-4 border-black p-4 mb-6 select-none">
                    <p class="text-sm font-semibold">Questions 11–16</p>
                    <p class="text-xs text-zinc-600 mt-1">What is the role of the volunteers in each of the following activities?</p>
                    <p class="text-xs text-zinc-700 mt-2 font-bold">Choose SIX answers from the box and write the correct letter, A-I, next to Questions 11-16.</p>
                </div>

                <div class="border border-zinc-200 bg-zinc-50 p-5 rounded-lg mb-8 text-sm space-y-1.5 select-none font-medium">
                    <div class="font-bold text-zinc-800 mb-2 uppercase tracking-wider text-xs">Roles of Volunteers:</div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <p><strong>A</strong> providing entertainment</p>
                        <p><strong>B</strong> providing publicity about a council service</p>
                        <p><strong>C</strong> contacting local businesses</p>
                        <p><strong>D</strong> giving advice to visitors</p>
                        <p><strong>E</strong> collecting feedback on events</p>
                        <p><strong>F</strong> selling tickets</p>
                        <p><strong>G</strong> introducing guest speakers at an event</p>
                        <p><strong>H</strong> encouraging cooperation between local organisations</p>
                        <p><strong>I</strong> helping people find their seats</p>
                    </div>
                </div>

                <div class="space-y-4 mb-10 max-w-2xl">
                    <div class="grid grid-cols-1 gap-3">
                        <!-- Q11 -->
                        <div class="question-target border border-zinc-200 rounded-lg p-4 bg-white flex justify-between items-center" id="q-target-11">
                            <span class="text-sm font-semibold">11. Walking around the town centre</span>
                            <select id="select-q11" class="custom-select border border-zinc-300 rounded px-3 py-1.5 text-xs font-bold outline-none text-blue-600 focus:border-blue-500 bg-white" data-qnum="11">
                                <option value="">Select Role</option>
                                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
                                <option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option>
                            </select>
                        </div>
                        <!-- Q12 -->
                        <div class="question-target border border-zinc-200 rounded-lg p-4 bg-white flex justify-between items-center" id="q-target-12">
                            <span class="text-sm font-semibold">12. Helping at concerts</span>
                            <select id="select-q12" class="custom-select border border-zinc-300 rounded px-3 py-1.5 text-xs font-bold outline-none text-blue-600 focus:border-blue-500 bg-white" data-qnum="12">
                                <option value="">Select Role</option>
                                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
                                <option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option>
                            </select>
                        </div>
                        <!-- Q13 -->
                        <div class="question-target border border-zinc-200 rounded-lg p-4 bg-white flex justify-between items-center" id="q-target-13">
                            <span class="text-sm font-semibold">13. Getting involved with community groups</span>
                            <select id="select-q13" class="custom-select border border-zinc-300 rounded px-3 py-1.5 text-xs font-bold outline-none text-blue-600 focus:border-blue-500 bg-white" data-qnum="13">
                                <option value="">Select Role</option>
                                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
                                <option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option>
                            </select>
                        </div>
                        <!-- Q14 -->
                        <div class="question-target border border-zinc-200 rounded-lg p-4 bg-white flex justify-between items-center" id="q-target-14">
                            <span class="text-sm font-semibold">14. Helping with a magazine</span>
                            <select id="select-q14" class="custom-select border border-zinc-300 rounded px-3 py-1.5 text-xs font-bold outline-none text-blue-600 focus:border-blue-500 bg-white" data-qnum="14">
                                <option value="">Select Role</option>
                                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
                                <option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option>
                            </select>
                        </div>
                        <!-- Q15 -->
                        <div class="question-target border border-zinc-200 rounded-lg p-4 bg-white flex justify-between items-center" id="q-target-15">
                            <span class="text-sm font-semibold">15. Participating at lunches for retired people</span>
                            <select id="select-q15" class="custom-select border border-zinc-300 rounded px-3 py-1.5 text-xs font-bold outline-none text-blue-600 focus:border-blue-500 bg-white" data-qnum="15">
                                <option value="">Select Role</option>
                                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
                                <option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option>
                            </select>
                        </div>
                        <!-- Q16 -->
                        <div class="question-target border border-zinc-200 rounded-lg p-4 bg-white flex justify-between items-center" id="q-target-16">
                            <span class="text-sm font-semibold">16. Helping with the website</span>
                            <select id="select-q16" class="custom-select border border-zinc-300 rounded px-3 py-1.5 text-xs font-bold outline-none text-blue-600 focus:border-blue-500 bg-white" data-qnum="16">
                                <option value="">Select Role</option>
                                <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option>
                                <option value="E">E</option><option value="F">F</option><option value="G">G</option><option value="H">H</option><option value="I">I</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Q17-20 Block -->
                <div class="bg-zinc-50 border-l-4 border-black p-4 mb-6 select-none">
                    <p class="text-sm font-semibold">Questions 17–20</p>
                    <p class="text-xs text-zinc-600 mt-1">Choose the correct letter, <span class="font-bold text-black">A, B or C</span>.</p>
                </div>

                <div class="space-y-6 mb-5 max-w-3xl">
                    <!-- Q17 -->
                    <div class="question-target border border-zinc-200 rounded-lg p-5 hover:border-zinc-400 transition-colors bg-white shadow-sm animate-fade-in" id="q-target-17" data-qnum="17">
                        <div class="text-sm font-bold mb-3">17. Which event requires the largest number of volunteers?</div>
                        <div class="flex flex-col gap-2 mc-options-grid" data-question="q17">
                            <button type="button" class="mc-opt-btn border border-zinc-300 rounded px-4 py-2.5 text-xs font-semibold hover:bg-zinc-100 transition-colors flex items-center gap-2.5" data-val="A">
                                <span class="radio-circle w-4 h-4 rounded-full border border-zinc-400 flex items-center justify-center shrink-0"><span class="radio-dot w-2 h-2 rounded-full bg-black scale-0 transition-transform duration-150"></span></span>
                                <span>A. the music festival</span>
                            </button>
                            <button type="button" class="mc-opt-btn border border-zinc-300 rounded px-4 py-2.5 text-xs font-semibold hover:bg-zinc-100 transition-colors flex items-center gap-2.5" data-val="B">
                                <span class="radio-circle w-4 h-4 rounded-full border border-zinc-400 flex items-center justify-center shrink-0"><span class="radio-dot w-2 h-2 rounded-full bg-black scale-0 transition-transform duration-150"></span></span>
