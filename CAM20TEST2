    <!-- KỊCH BẢN ĐIỀU KHIỂN CHÍNH -->
    <script>
        // Đáp án chuẩn Test 2 của bạn (bao gồm so khớp nhiều phương án từ đồng nghĩa)
        const KEY_ANSWERS = {
            q1: "break",
            q2: "time",
            q3: "shower",
            q4: "money",
            q5: "memory",
            q6: "lifting",
            q7: "fall",
            q8: "taxi",
            q9: "insurance",
            q10: "stress",
            q11: "D",
            q12: "I",
            q13: "H",
            q14: "E",
            q15: "A",
            q16: "B",
            q17: "B",
            q18: "A",
            q19: "B",
            q20: "A",
            q21: "D",
            q22: "G",
            q23: "B",
            q24: "A",
            q25: "E",
            q26: "C",
            q27: "A",
            q28: "A",
            q29: "B",
            q30: "C",
            q31: ["photos", "photographs", "pictures"], // Chấp nhận cả 3 từ cho câu 31
            q32: "vegan",
            q33: ["chefs", "cooks"],                     // Chấp nhận cả 2 từ cho câu 33
            q34: ["journalists", "reporters"],           // Chấp nhận cả 2 từ cho câu 34
            q35: "health",
            q36: "coffee",
            q37: "environment",
            q38: "reputation",
            q39: ["price", "cost"],                      // Chấp nhận cả 2 từ cho câu 39
            q40: "soil"
        };

        const USER_ANSWERS = {};
        let isTimerRunning = false;
        let timerSeconds = 40 * 60; // 40 phút thi Listening
        let timerInterval = null;
        let hasGraded = false;

        const audio = document.getElementById('exam-audio');
        const audioStatusLabel = document.getElementById('audio-status-label');
        const questionsWorkspace = document.getElementById('questions-workspace');
        
        // Cấu hình kéo thả file âm thanh cục bộ
        const dropZone = document.getElementById('audio-drop-zone');
        const localAudioInput = document.getElementById('local-audio-input');
        const btnStartTest = document.getElementById('btn-start-test');
        const dropIcon = document.getElementById('audio-drop-icon');
        const dropText = document.getElementById('audio-drop-text');

        // Sự kiện click vào vùng drop để duyệt tìm file
        dropZone.addEventListener('click', () => {
            localAudioInput.click();
        });

        // Xử lý tệp được chọn qua duyệt thư mục
        localAudioInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleAudioFile(e.target.files[0]);
            }
        });

        // Ngăn chặn sự kiện mặc định của trình duyệt để kéo thả hoạt động
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
            document.body.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults (e) {
            e.preventDefault();
            e.stopPropagation();
        }

        // Tạo hiệu ứng tương tác kéo tệp qua vùng thả
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.add('border-black', 'bg-zinc-100');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.remove('border-black', 'bg-zinc-100');
            }, false);
        });

        // Xử lý sự kiện thả tệp (Drop)
        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;
            if (files.length > 0) {
                handleAudioFile(files[0]);
            }
        });

        // Hàm xử lý và nạp file nhạc cục bộ bằng Object URL
        function handleAudioFile(file) {
            if (!file.type.startsWith('audio/')) {
                alert('Vui lòng chọn một tệp âm thanh hợp lệ (.mp3, .wav, .m4a, ...)!');
                return;
            }
            
            try {
                const objectURL = URL.createObjectURL(file);
                audio.src = objectURL;
                
                // Cập nhật trạng thái giao diện vùng dropzone thành màu xanh thành công
                dropZone.classList.remove('border-zinc-300');
                dropZone.classList.add('border-green-500', 'bg-green-50/50');
                dropIcon.className = "fa-solid fa-circle-check text-4xl text-green-500 animate-bounce";
                dropText.innerHTML = `Loaded: <strong class="text-green-800">${file.name}</strong>`;
                
                // Mở khóa nút bắt đầu thi
                btnStartTest.disabled = false;
                btnStartTest.className = "bg-black hover:bg-zinc-800 text-white font-bold py-4 px-10 text-xs uppercase tracking-widest rounded-lg transition-all cursor-pointer shadow-md w-full animate-pulse";
                btnStartTest.textContent = "Start Test Now";
                
                // Cập nhật nhãn trạng thái trên header
                audioStatusLabel.innerHTML = `<i class="fa-solid fa-headphones text-green-500"></i> ${file.name.substring(0, 20)}...`;
            } catch (err) {
                console.error("Lỗi khi nạp file:", err);
                alert("Không thể tải tệp âm thanh này. Vui lòng thử lại bằng một tệp khác.");
            }
        }

        // HÀM BẮT ĐẦU THI (Mô phỏng CD thi thật, không có Play/Pause, tự phát liền mạch)
        btnStartTest.addEventListener('click', () => {
            document.getElementById('start-modal').classList.add('opacity-0', 'pointer-events-none');
            
            // Tự động phát toàn bộ test
            audio.play().then(() => {
                audioStatusLabel.innerHTML = `<i class="fa-solid fa-circle-play text-green-500 animate-ping"></i> Test Audio Playing...`;
            }).catch(err => {
                console.error("Autoplay rejected:", err);
                audioStatusLabel.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-red-500"></i> Audio blocked. Adjust system settings.`;
            });
            
            // Chạy thời gian làm bài
            startTimer();
        });

        // ĐIỀU CHỈNH ÂM LƯỢNG (Volume)
        const volumeControl = document.getElementById('volume-control');
        volumeControl.addEventListener('input', (e) => {
            audio.volume = e.target.value;
        });

        // ĐIỀU HƯỚNG TAB TRÁI/PHẢI
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const partNum = this.getAttribute('data-target');
                switchTab(partNum);
            });
        });

        function switchTab(partNum) {
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('active', 'border-black', 'text-black');
                b.classList.add('text-zinc-500', 'border-transparent');
                if (b.getAttribute('data-target') === partNum.toString()) {
                    b.classList.add('active', 'border-black', 'text-black');
                }
            });

            document.querySelectorAll('.part-content').forEach(cont => {
                cont.classList.add('hidden');
                cont.classList.remove('block');
            });
            document.getElementById(`part-content-${partNum}`).classList.remove('hidden');
            document.getElementById(`part-content-${partNum}`).classList.add('block');
        }

        // CUỘN TỚI VỊ TRÍ CÂU HỎI KHI BẤM SIDEBAR NAVIGATION
        function scrollToQuestion(qNum) {
            let partTarget = 1;
            if (qNum >= 11 && qNum <= 20) partTarget = 2;
            else if (qNum >= 21 && qNum <= 30) partTarget = 3;
            else if (qNum >= 31 && qNum <= 40) partTarget = 4;

            switchTab(partTarget);

            let targetEl = null;
            const isInput = (qNum >= 1 && qNum <= 10) || (qNum >= 31 && qNum <= 40);
            const isSelect = (qNum >= 11 && qNum <= 16) || (qNum >= 21 && qNum <= 25);
            const isRadio = (qNum >= 17 && qNum <= 20) || (qNum >= 26 && qNum <= 30);

            if (isInput) {
                targetEl = document.getElementById(`blank-q${qNum}`);
            } else if (isSelect) {
                targetEl = document.getElementById(`select-q${qNum}`);
            } else if (isRadio) {
                targetEl = document.getElementById(`q-target-${qNum}`);
            }

            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                const highlightWrapper = targetEl.closest('.question-target') || targetEl;
                highlightWrapper.classList.add('highlight-scroll');
                setTimeout(() => {
                    highlightWrapper.classList.remove('highlight-scroll');
                }, 1000);

                if (targetEl.tagName === 'INPUT' || targetEl.tagName === 'SELECT') {
                    setTimeout(() => targetEl.focus(), 300);
                }
            }
        }

        // BỘ ĐẾM THỜI GIAN NGƯỢC
        function startTimer() {
            if (isTimerRunning) return;
            isTimerRunning = true;
            timerInterval = setInterval(() => {
                timerSeconds--;
                if (timerSeconds <= 0) {
                    clearInterval(timerInterval);
                    timerSeconds = 0;
                    gradeTest();
                }
                updateTimerDisplay();
            }, 1000);
        }

        function updateTimerDisplay() {
            const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
            const s = (timerSeconds % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').textContent = `${m}:${s}`;
            
            if (timerSeconds < 120) {
                document.getElementById('countdown-timer').classList.add('bg-red-950', 'text-red-500', 'border-red-800');
            }
        }

        // LƯU TRẠNG THÁI NHẬP CÂU TRẢ LỜI ĐIỀN KHUYẾT
        document.querySelectorAll('input[type="text"]').forEach(input => {
            input.addEventListener('input', function() {
                const qNum = this.getAttribute('data-qnum');
                const val = this.value.trim();
                USER_ANSWERS[`q${qNum}`] = val;
                updateNavStatus(qNum, val !== '');
            });
        });

        // LƯU TRẠNG THÁI CHỌN DROPDOWN MATCHING
        document.querySelectorAll('select').forEach(select => {
            select.addEventListener('change', function() {
                const qNum = this.getAttribute('data-qnum');
                const val = this.value;
                USER_ANSWERS[`q${qNum}`] = val;
                updateNavStatus(qNum, val !== '');
            });
        });

        // LỰA CHỌN TRẮC NGHIỆM ĐƠN (MULTIPLE CHOICE)
        document.querySelectorAll('.mc-options-grid').forEach(grid => {
            const qKey = grid.getAttribute('data-question');
            const qNum = qKey.replace('q', '');
            const buttons = grid.querySelectorAll('.mc-opt-btn');

            buttons.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (hasGraded) return;
                    buttons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    
                    const val = this.getAttribute('data-val');
                    USER_ANSWERS[qKey] = val;
                    updateNavStatus(qNum, true);
                });
            });
        });

        function updateNavStatus(qNum, hasVal) {
            const btn = document.getElementById(`nav-btn-q${qNum}`);
            if (btn) {
                if (hasVal) {
                    btn.classList.add('bg-black', 'text-white', 'border-black');
                    btn.classList.remove('bg-white', 'text-zinc-800', 'border-zinc-300');
                } else {
                    btn.classList.remove('bg-black', 'text-white', 'border-black');
                    btn.classList.add('bg-white', 'text-zinc-800', 'border-zinc-300');
                }
            }
        }

        // HÀM CHẤM ĐIỂM HOÀN CHỈNH CHO TEST 2
        function gradeTest() {
            if (hasGraded) return;
            hasGraded = true;
            isTimerRunning = false;
            clearInterval(timerInterval);
            audio.pause();
            audioStatusLabel.innerHTML = `<i class="fa-solid fa-lock text-zinc-500"></i> Locked`;

            document.getElementById('btn-submit-exam').disabled = true;
            document.getElementById('btn-submit-exam').classList.add('opacity-50', 'cursor-not-allowed');

            let score = 0;

            for (let i = 1; i <= 40; i++) {
                const qKey = `q${i}`;
                const userAns = (USER_ANSWERS[qKey] || "").trim().toLowerCase();
                const targetAns = KEY_ANSWERS[qKey];

                let isCorrect = false;

                // Xử lý so khớp các câu trả lời linh hoạt (mảng đáp án đồng nghĩa)
                if (Array.isArray(targetAns)) {
                    isCorrect = targetAns.map(ans => ans.toLowerCase().trim()).includes(userAns);
                } else {
                    isCorrect = userAns === targetAns.toLowerCase().trim();
                }

                if (isCorrect) score++;

                // Phản hồi kết quả lên cột biểu tượng điều hướng câu hỏi bên phải
                const navBtn = document.getElementById(`nav-btn-q${i}`);
                if (navBtn) {
                    navBtn.className = `nav-btn h-9 rounded text-[11px] font-bold flex items-center justify-center cursor-pointer select-none transition-colors ${isCorrect ? 'nav-correct' : 'nav-wrong'}`;
                }

                const isInput = (i >= 1 && i <= 10) || (i >= 31 && i <= 40);
                const isSelect = (i >= 11 && i <= 16) || (i >= 21 && i <= 25);
                const isRadio = (i >= 17 && i <= 20) || (i >= 26 && i <= 30);

                if (isInput) {
                    const input = document.getElementById(`blank-q${i}`);
                    if (input) {
                        input.disabled = true;
                        if (isCorrect) {
                            input.className = "blank-underlined font-mono font-bold text-center px-1 w-40 text-green-700 bg-green-50 border-bottom-2 border-green-600";
                        } else {
                            input.className = "blank-underlined font-mono font-bold text-center px-1 w-40 text-red-600 bg-red-50 border-bottom-2 border-red-500 text-line-through";
                            
                            // Gắn nhãn đáp án đúng bên cạnh ô nhập liệu sai
                            const corrSpan = document.createElement('span');
                            corrSpan.className = 'ml-1.5 inline-block text-[11px] text-green-700 font-sans font-bold bg-green-100 border border-green-300 rounded px-1.5 py-0.5 select-all';
                            corrSpan.textContent = Array.isArray(targetAns) ? targetAns.join(' / ') : targetAns;
                            input.parentNode.appendChild(corrSpan);
                        }
                    }
                } else if (isSelect) {
                    const select = document.getElementById(`select-q${i}`);
                    if (select) {
                        select.disabled = true;
                        if (isCorrect) {
                            select.className = "custom-select border border-green-500 rounded px-3 py-1.5 text-xs font-bold outline-none bg-green-50 text-green-700";
                        } else {
                            select.className = "custom-select border border-red-500 rounded px-3 py-1.5 text-xs font-bold outline-none bg-red-50 text-red-600 text-line-through";
                            
                            const corrSpan = document.createElement('span');
                            corrSpan.className = 'ml-1.5 inline-block text-[11px] text-green-700 font-sans font-bold bg-green-100 border border-green-300 rounded px-1.5 py-0.5';
                            corrSpan.textContent = `Correct: ${targetAns}`;
                            select.parentNode.appendChild(corrSpan);
                        }
                    }
                } else if (isRadio) {
                    const targetCard = document.getElementById(`q-target-${i}`);
                    if (targetCard) {
                        const buttons = targetCard.querySelectorAll('.mc-opt-btn');
                        buttons.forEach(btn => {
                            btn.disabled = true;
                            const btnVal = btn.getAttribute('data-val');
                            if (btnVal === targetAns) {
                                btn.classList.add('graded-correct');
                            } else if (btnVal === USER_ANSWERS[qKey]) {
                                btn.classList.add('graded-wrong');
                            } else {
                                btn.classList.add('opacity-50');
                            }
                        });
                    }
                }
            }

            // Hiển thị Band Score và điểm thô
            document.getElementById('modal-score').textContent = `${score}/40`;
            document.getElementById('modal-band-score').textContent = calculateBandScore(score);
            document.getElementById('score-modal').classList.remove('opacity-0', 'pointer-events-none');
            document.getElementById('score-modal-content').classList.remove('scale-95');
        }

        function calculateBandScore(score) {
            if (score >= 39) return "9.0";
            if (score >= 37) return "8.5";
            if (score >= 35) return "8.0";
            if (score >= 32) return "7.5";
            if (score >= 30) return "7.0";
            if (score >= 26) return "6.5";
            if (score >= 23) return "6.0";
            if (score >= 20) return "5.5";
            if (score >= 16) return "5.0";
            if (score >= 13) return "4.5";
            if (score >= 10) return "4.0";
            if (score >= 6) return "3.5";
            if (score >= 4) return "3.0";
            return "2.5";
        }

        document.getElementById('modal-close-btn').addEventListener('click', () => {
            document.getElementById('score-modal').classList.add('opacity-0', 'pointer-events-none');
            document.getElementById('score-modal-content').classList.add('scale-95');
        });

        // HỆ THỐNG HIGHLIGHT VĂN BẢN (CHỈ DÀNH CHO CÂU HỎI)
        const highlightMenu = document.getElementById('highlight-menu');
        
        document.addEventListener('mouseup', (e) => {
            if (!questionsWorkspace.contains(e.target)) return;
            setTimeout(() => {
                const selection = window.getSelection();
                if (selection.isCollapsed || selection.toString().trim() === "") {
                    highlightMenu.style.display = 'none'; return;
                }
                const range = selection.getRangeAt(0);
                const rect = range.getBoundingClientRect();
                highlightMenu.style.left = `${Math.max(10, rect.left + (rect.width / 2) - 65)}px`;
                highlightMenu.style.top = `${Math.max(10, rect.top - 48)}px`;
                highlightMenu.style.display = 'flex';
            }, 10);
        });

        questionsWorkspace.addEventListener('scroll', () => highlightMenu.style.display = 'none');

        document.querySelectorAll('.hl-color-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const color = this.getAttribute('data-color');
                const selection = window.getSelection();
                if (!selection.rangeCount || selection.toString().trim() === "") return;
                
                const range = selection.getRangeAt(0);
                const mark = document.createElement('mark');
                mark.className = 'ielts-highlight'; 
                mark.style.backgroundColor = color;
                
                mark.addEventListener('click', function(e) { 
                    e.stopPropagation(); 
                    this.replaceWith(...this.childNodes); 
                });
                
                try { 
                    range.surroundContents(mark); 
                } catch (err) { 
                    const frag = range.extractContents(); 
                    mark.appendChild(frag); 
                    range.insertNode(mark); 
                }
                selection.removeAllRanges(); 
                highlightMenu.style.display = 'none';
            });
        });

        document.getElementById('btn-clear-selection').addEventListener('click', e => {
            e.stopPropagation();
            const selection = window.getSelection();
            if (!selection.rangeCount) return;
            const range = selection.getRangeAt(0);
            const parent = range.commonAncestorContainer;
            const marks = (parent.nodeType === 1 ? parent : parent.parentNode).querySelectorAll('mark.ielts-highlight');
            marks.forEach(mark => { 
                if (selection.containsNode(mark, true)) mark.replaceWith(...mark.childNodes); 
            });
            selection.removeAllRanges(); 
            highlightMenu.style.display = 'none';
        });

        document.addEventListener('mousedown', e => { 
            if (!highlightMenu.contains(e.target) && e.target.nodeName !== 'MARK') highlightMenu.style.display = 'none'; 
        });

        // BỘ CO GIÃN PHÂN VÙNG GIAO DIỆN (SPLITTER RESIZE)
        const resizeHandle = document.getElementById('resize-handle');
        const sidebarPanel = document.getElementById('sidebar-panel');
        const workspaceContainer = document.getElementById('workspace-container');
        let isResizing = false;

        function startResize(e) { 
            isResizing = true; 
            resizeHandle.classList.add('bg-black'); 
            document.body.style.cursor = 'col-resize'; 
            document.body.style.userSelect = 'none'; 
        }
        function onResize(e) {
            if (!isResizing) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const rect = workspaceContainer.getBoundingClientRect();
            let newWidthPercent = ((clientX - rect.left) / rect.width) * 100;
            
            newWidthPercent = Math.min(Math.max(newWidthPercent, 60), 90);
            questionsWorkspace.style.width = `${newWidthPercent}%`;
            sidebarPanel.style.width = `${100 - newWidthPercent}%`;
        }
        function stopResize() { 
            if (isResizing) { 
                isResizing = false; 
                resizeHandle.classList.remove('bg-black'); 
                document.body.style.cursor = ''; 
                document.body.style.userSelect = ''; 
            } 
        }

        resizeHandle.addEventListener('mousedown', startResize); 
        document.addEventListener('mousemove', onResize); 
        document.addEventListener('mouseup', stopResize);
        resizeHandle.addEventListener('touchstart', startResize); 
        document.addEventListener('touchmove', onResize); 
        document.addEventListener('touchend', stopResize);

        // ĐĂNG KÝ SỰ KIỆN NỘP BÀI THI (CONFIRM TIẾNG VIỆT)
        document.getElementById('btn-submit-exam').addEventListener('click', () => {
            const confirmBox = confirm("Bạn có chắc chắn muốn nộp bài thi Listening ngay bây giờ không? Hành động này sẽ khóa toàn bộ đáp án và hiển thị bảng điểm.");
            if (confirmBox) {
                gradeTest();
            }
        });
    </script>
</body>
</html>
